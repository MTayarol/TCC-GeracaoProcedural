# Normalização de fim de linha para arquivos de texto
* text=auto

# Arquivos de código e documentação
*.cs     text diff=csharp
*.md     text
*.asmdef text
*.json   text

# Arquivos YAML da Unity (cenas, prefabs, assets, metas)
*.unity  text eol=lf
*.prefab text eol=lf
*.asset  text eol=lf
*.meta   text eol=lf
*.mat    text eol=lf

# Binários
*.png  binary
*.jpg  binary
*.psd  binary
*.fbx  binary
